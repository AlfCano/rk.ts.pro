	<logic>
		<convert id="cond_cv_ts" sources="cv_mode.string" mode="equals" standard="ts" />
		<convert id="cond_cv_df" sources="cv_mode.string" mode="equals" standard="fable" />
		<connect governor="cond_cv_ts" client="frm_cv_ts.enabled" />
		<connect governor="cond_cv_df" client="frm_cv_df.enabled" />
		<script>
			gui.addChangeCommand("cv_mode.string", "update_cv_root()");
	    gui.addChangeCommand("cv_df.available", "update_cv_root()");
	    function update_cv_root() {
	       var mode = gui.getValue("cv_mode.string");
	       var df = gui.getValue("cv_df.available");
	       if (mode === "fable") {
	          if (df !== "") {
	             gui.setValue("cv_vs.root", df);
	          } else {
	             gui.setValue("cv_vs.root", "");
	          }
	       } else {
	          gui.setValue("cv_vs.root", "");
	       }
	    }
		</script>
	</logic>
	<dialog label="3. Time-Series Cross-Validation (Backtesting)">
		<row id="row_v1DE1DEBEU">
			<varselector id="cv_vs" />
			<column id="clm_t1DE1DEBEU">
				<tabbook>
					<tab label="1. Data &amp; Engine" id="tab_1DatEngn">
						<column id="clm_rBEUOCVEHD">
							<radio id="cv_mode" label="Backtesting Engine">
								<option label="Univariate ts Object (forecast::tsCV — Error by Horizon h)" value="ts" checked="true" />
