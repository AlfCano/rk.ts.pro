							</frame>
							<frame label="tsibble / fable Rolling Input" id="frm_cv_df">
								<varslot id="cv_df" label="Data Frame" source="cv_vs" classes="data.frame" />
								<varslot id="cv_idx" label="Time Index Column" source="cv_vs" />
								<dropdown id="cv_gran" label="Time Granularity">
									<option label="Monthly (yearmonth)" value="month" checked="true" />
									<option label="Quarterly (yearquarter)" value="quarter" />
									<option label="Weekly (yearweek)" value="week" />
									<option label="Daily (as.Date)" value="day" />
									<option label="Native / Numeric" value="raw" />
								</dropdown>
								<varslot id="cv_y" label="Target Variable (Y, Numeric)" source="cv_vs" classes="numeric integer" />
								<spinbox label="Step Between Rolling Folds (.step)" id="cv_step" initial="3" min="1" max="60" type="integer" />
							</frame>
							<stretch />
						</column>
					</tab>
