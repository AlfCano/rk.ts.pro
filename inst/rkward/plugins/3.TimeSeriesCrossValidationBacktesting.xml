								</dropdown>
								<input label="Main Title (Leave empty for default)" id="cv_plot_main" />
							</frame>
							<frame label="HTML Graphics Size &amp; Resolution" id="frm_HTMLGrSR">
								<row id="row_sHTMLPW850">
									<spinbox label="HTML Plot Width (pixels)" id="cv_plot_w" initial="850" min="100" max="5000" type="integer" />
